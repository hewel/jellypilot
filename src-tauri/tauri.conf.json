{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JellyPilot",
  "version": "1.5.0",
  "identifier": "top.pigfun.jellypilot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "JellyPilot",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**/*"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "../packaging/ffmpeg/THIRD_PARTY_NOTICES.md": "licenses/ffmpeg/THIRD_PARTY_NOTICES.md",
      "../packaging/ffmpeg/manifest.json": "licenses/ffmpeg/manifest.json",
      "binaries/ffmpeg.LICENSE.txt": "licenses/ffmpeg/LICENSE.txt",
      "binaries/ffmpeg.BUILD-INFO.txt": "licenses/ffmpeg/BUILD-INFO.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
