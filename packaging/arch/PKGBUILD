# Maintainer: Hewel <13846369+hewel@users.noreply.github.com>

pkgname=jellypilot
pkgver=2.2.3
pkgrel=1
pkgdesc='Jellyfin and Emby companion app with embedded MPV from the pinned mpv fork'
arch=('x86_64')
url='https://github.com/hewel/jellypilot'
license=('MIT')
# makepkg's default LTOFLAGS (-flto=auto) compile aws-lc-sys's C objects into
# GCC fat-LTO bitcode that rust-lld cannot link; keep the build non-LTO.
# Preserve the staged runtime hashes; do not strip or split debug data afterward.
options=('!lto' '!strip' '!debug')
# The pinned libplacebo runtime and its required closure are bundled privately.
# Keep the distro Vulkan loader; FFmpeg may still use Arch's own libplacebo SONAME.
depends=(
  'gtk3'
  'libxkbcommon'
  'wayland'
  'ffmpeg'
  'libass'
  'luajit'
  'mujs'
  'vulkan-icd-loader'
)
optdepends=(
  'mpv: External MPV Playback'
)
makedepends=(
  'git'
  'rust'
  'bun'
  'meson'
  'ninja'
  'pkgconf'
  'binutils'
  'patchelf'
  'licenses'
  'vulkan-headers'
  'ffmpeg'
  'glslang'
  'libass'
  'shaderc'
  'lcms2'
)
conflicts=('jellypilot-bin')
source=(
  "git+https://github.com/hewel/jellypilot.git#tag=v$pkgver"
  'top.pigfun.jellypilot.desktop'
)
sha256sums=(
  'SKIP'
  '24b41b6713ba0b61c5b451dedd08b3ebb72b1eda4d49eadfadffe313d9dcc0be'
)

build() {
  cd "$srcdir/$pkgname"

  bun install --frozen-lockfile
  bun run task mpv linux-runtime
  bun run task iced build --release
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 "target/release/jellypilot" "$pkgdir/usr/bin/jellypilot"
  install -Dm755 "target/release/jellypilot-diagnostics" "$pkgdir/usr/bin/jellypilot-diagnostics"
  install -d "$pkgdir/usr/lib/jellypilot"
  install -m755 "target/embedded-mpv/lib/jellypilot/"*.so* "$pkgdir/usr/lib/jellypilot/"
  install -Dm644 "target/embedded-mpv/share/jellypilot/mpv-baseline.conf" \
    "$pkgdir/usr/share/jellypilot/mpv-baseline.conf"
  install -Dm644 "target/embedded-mpv/manifest.json" \
    "$pkgdir/usr/share/jellypilot/mpv-manifest.json"
  install -d "$pkgdir/usr/share/jellypilot/licenses"
  cp -a "target/embedded-mpv/share/jellypilot/licenses/linux-runtime" \
    "$pkgdir/usr/share/jellypilot/licenses/"
  install -Dm644 "$srcdir/top.pigfun.jellypilot.desktop" \
    "$pkgdir/usr/share/applications/top.pigfun.jellypilot.desktop"
  install -Dm644 "assets/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/top.pigfun.jellypilot.png"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
