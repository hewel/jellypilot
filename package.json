{
  "name": "jellypilot",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "dev:rsdoctor": "RSDOCTOR=true rsbuild",
    "build:rsdoctor": "RSDOCTOR=true rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "build:e2e": "tsx e2e/cli.ts build",
    "test:e2e": "tsx e2e/cli.ts test",
    "typecheck:e2e": "tsx e2e/cli.ts typecheck",
    "e2e": "bun run typecheck:e2e && bun run build:e2e && bun run test:e2e",
    "check:e2e-isolation": "tsx e2e/cli.ts isolation",
    "e2e:verify": "tsx e2e/cli.ts verify",
    "e2e:clean": "tsx e2e/cli.ts clean",
    "ffmpeg:prepare": "bun scripts/prepare-ffmpeg-sidecar.ts",
    "ffmpeg:verify": "bun scripts/prepare-ffmpeg-sidecar.ts --verify",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "api": "bun scripts/media-server-api.ts",
    "format": "oxfmt --write package.json tsconfig.json tests/tsconfig.json e2e/tsconfig.json '*.config.{js,json,jsonc,mjs,ts}' 'src/**/*.{css,js,jsx,json,jsonc,ts,tsx}' 'tests/**/*.{js,jsx,json,jsonc,ts,tsx}' 'e2e/**/*.{js,jsx,json,jsonc,ts,tsx}' 'scripts/**/*.ts' 'src-tauri/**/*.json'",
    "format:check": "oxfmt --check package.json tsconfig.json tests/tsconfig.json e2e/tsconfig.json '*.config.{js,json,jsonc,mjs,ts}' 'src/**/*.{css,js,jsx,json,jsonc,ts,tsx}' 'tests/**/*.{js,jsx,json,jsonc,ts,tsx}' 'e2e/**/*.{js,jsx,json,jsonc,ts,tsx}' 'scripts/**/*.ts' 'src-tauri/**/*.json'",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern src tests e2e scripts rsbuild.config.ts rstest.config.ts rstest.setup.ts panda.config.ts postcss.config.mjs lint-staged.config.mjs",
    "lint:fix": "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern src tests e2e scripts rsbuild.config.ts rstest.config.ts rstest.setup.ts panda.config.ts postcss.config.mjs lint-staged.config.mjs",
    "check": "bun run format:check && bun run lint && bun run check:effect-rules && bun run check:styling-boundaries && bun run typecheck && bun run rust:fmt:check && bun run rust:clippy",
    "test:all": "bun run test && bun run rust:test",
    "prepare": "husky && bun run panda:codegen && effect-tsgo patch",
    "rust:fmt": "cargo fmt --manifest-path Cargo.toml --package jellypilot --package jellypilot-core --package jellypilot-core-wasm --package jellypilot-playback-core",
    "rust:fmt:check": "cargo fmt --manifest-path Cargo.toml --package jellypilot --package jellypilot-core --package jellypilot-core-wasm --package jellypilot-playback-core -- --check",
    "rust:check": "cargo check --manifest-path Cargo.toml --workspace",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --no-deps -- -D warnings && cargo clippy --manifest-path Cargo.toml --package jellypilot-core --package jellypilot-core-wasm --package jellypilot-playback-core --all-targets --all-features --no-deps -- -D warnings",
    "rust:clippy:core": "cargo clippy --manifest-path Cargo.toml --package jellypilot-core --all-targets --all-features --no-deps -- -D warnings",
    "rust:clippy:wasm": "cargo clippy --manifest-path Cargo.toml --package jellypilot-core-wasm --all-targets --all-features --no-deps -- -D warnings",
    "rust:clippy:playback": "cargo clippy --manifest-path Cargo.toml --package jellypilot-playback-core --all-targets --all-features --no-deps -- -D warnings",
    "rust:test:playback": "cargo test --manifest-path Cargo.toml --package jellypilot-playback-core",
    "rust:test": "cargo test --manifest-path Cargo.toml --workspace",
    "wasm:install": "cargo install wasm-pack --version 0.15.0 --locked",
    "wasm:build": "bun scripts/build-library-browse-wasm.ts",
    "wasm:build:dev": "bun scripts/build-library-browse-wasm.ts --dev",
    "wasm:build:release": "bun scripts/build-library-browse-wasm.ts --release",
    "panda:codegen": "panda codegen",
    "predev": "bun run ffmpeg:prepare && bun run wasm:build:dev",
    "predev:rsdoctor": "bun run ffmpeg:prepare && bun run panda:codegen && bun run wasm:build:dev",
    "prebuild": "bun run ffmpeg:prepare && bun run panda:codegen && bun run wasm:build",
    "prebuild:rsdoctor": "bun run ffmpeg:prepare && bun run panda:codegen && bun run wasm:build:release",
    "pretypecheck": "bun run panda:codegen && bun run wasm:build:dev",
    "pretypecheck:e2e": "bun run wasm:build:dev",
    "pretest": "bun run wasm:build:dev",
    "pretest:watch": "bun run wasm:build:dev",
    "prebuild:e2e": "bun run ffmpeg:prepare && bun run wasm:build:dev",
    "pree2e:verify": "bun run ffmpeg:prepare && bun run wasm:build:dev",
    "check:styling-boundaries": "bun scripts/check-styling-boundaries.ts",
    "review:panda:tauri": "bun tauri dev --config src-tauri/tauri.panda-review.conf.json",
    "review:parity": "bun scripts/tauri-parity-review.ts",
    "check:effect-rules": "bun scripts/check-no-switch.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.37.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@solid-devtools/overlay": "^0.33.5",
    "@tanstack/solid-form": "^1.33.2",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-router": "1.170.18",
    "@tanstack/solid-virtual": "^3.13.35",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "effect": "^4.0.0-beta.102",
    "hls.js": "1.6.17",
    "lucide-solid": "^1.20.0",
    "solid-js": "^1.9.14"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.3",
    "@openapitools/openapi-generator-cli": "^2.38.0",
    "@pandacss/dev": "1.11.4",
    "@rsbuild/core": "^2.0.15",
    "@rsbuild/plugin-babel": "^1.2.1",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@rsdoctor/rspack-plugin": "^1.5.15",
    "@rstest/core": "^0.10.5",
    "@tanstack/router-plugin": "^1.168.18",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/native-types": "2.4.0",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "ffmpeg-static": "5.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "webdriverio": "9.29.1"
  }
}
